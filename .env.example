# .env.example
# Use this file as a template for production deployment

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/natya_kshethram"

# NextAuth Configuration
# Run `npx auth secret` or `openssl rand -base64 32` to generate a strong secret
AUTH_SECRET="your-super-secure-auth-secret-here"

# NextAuth Public URL (Required in production for many providers)
# e.g., https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Add any additional production environment variables below (e.g., SMTP, S3 storage keys)
